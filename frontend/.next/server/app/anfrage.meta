{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/anfrage/layout,_N_T_/anfrage/page,_N_T_/anfrage"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/anfrage/__PAGE__",
    "/anfrage",
    "/_index",
    "/_head"
  ]
}