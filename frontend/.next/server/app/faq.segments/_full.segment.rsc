11:T7ff,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Wie früh muss man buchen?","acceptedAnswer":{"@type":"Answer","text":"Wir empfehlen mindestens 4–8 Wochen im Voraus, bei grossen Festivals gerne früher. Kurzfristige Anfragen prüfen wir ebenfalls gerne."}},{"@type":"Question","name":"Wie viele Gäste sind möglich?","acceptedAnswer":{"@type":"Answer","text":"Einzelne Trucks sind auf bis zu 300 Gäste/Stunde ausgelegt. Bei grösseren Events können mehrere Trucks gleichzeitig eingesetzt werden."}},{"@type":"Question","name":"Kommt ihr in die ganze Schweiz?","acceptedAnswer":{"@type":"Answer","text":"Ja. Unser Heimgebiet ist Zürich, Wetzikon und der Zürcher Oberland, aber wir fahren für Events in die ganze Schweiz – je nach Aufwand mit Anfahrtspauschale."}},{"@type":"Question","name":"Braucht ihr Strom und Wasser?","acceptedAnswer":{"@type":"Answer","text":"Je nach Truck unterschiedlich. Die genauen technischen Anforderungen geben wir euch nach der Anfrage mit den Unterlagen weiter."}},{"@type":"Question","name":"Gibt es vegetarische/vegane Optionen?","acceptedAnswer":{"@type":"Answer","text":"Ja, bei allen Konzepten sind vegetarische Optionen verfügbar. Vegane Anpassungen sind je nach Konzept möglich – bitte beim Anfragen angeben."}},{"@type":"Question","name":"Was kostet ein Foodtruck-Einsatz?","acceptedAnswer":{"@type":"Answer","text":"Der Preis hängt von Gästezahl, Ort, Einsatzdauer und Konzept ab. Wir kalkulieren individuell und senden euch eine transparente Offerte."}},{"@type":"Question","name":"Kann man mehrere Trucks buchen?","acceptedAnswer":{"@type":"Answer","text":"Ja, genau das ist unsere Stärke. Ihr könnt mehrere Konzepte kombinieren und so für Abwechslung und kürzere Wartezeiten sorgen."}},{"@type":"Question","name":"Was passiert bei schlechtem Wetter?","acceptedAnswer":{"@type":"Answer","text":"Unsere Trucks sind grundsätzlich wetterfest. Bei extremen Bedingungen besprechen wir gemeinsam Alternativen. Details regeln wir im Vertrag."}}]}5:["$","$L10",null,{"children":[["$","script",null,{"id":"faq-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}],["$","script",null,{"id":"faq-breadcrumb-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Startseite\",\"item\":\"https://trucksonroad.ch\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"FAQ\",\"item\":\"https://trucksonroad.ch/faq\"}]}"}}],["$","$L12",null,{"initialFaqs":[{"id":"e94419ea-563c-43ed-902c-e6f73afb2a00","question_de":"Wie früh muss man buchen?","answer_de":"Wir empfehlen mindestens 4–8 Wochen im Voraus, bei grossen Festivals gerne früher. Kurzfristige Anfragen prüfen wir ebenfalls gerne.","question_en":"How far in advance should I book?","answer_en":"We recommend at least 4-8 weeks in advance, for large festivals preferably earlier. We're also happy to review short-notice inquiries.","order":1,"answer_fr":"Nous recommandons au moins 4 à 8 semaines à l'avance, de préférence plus tôt pour les grands festivals. Nous examinons également volontiers les demandes de dernière minute.","answer_it":"Consigliamo almeno 4-8 settimane di anticipo, preferibilmente di più per i grandi festival. Esaminiamo volentieri anche le richieste dell'ultimo minuto.","question_fr":"Combien de temps à l'avance faut-il réserver ?","question_it":"Con quanto anticipo bisogna prenotare?"},{"id":"951107e1-c0d8-4c4f-a3c8-fa15f1afa6c2","question_de":"Wie viele Gäste sind möglich?","answer_de":"Einzelne Trucks sind auf bis zu 300 Gäste/Stunde ausgelegt. Bei grösseren Events können mehrere Trucks gleichzeitig eingesetzt werden.","question_en":"How many guests are possible?","answer_en":"Individual trucks can serve up to 300 guests per hour. For larger events, multiple trucks can be deployed simultaneously.","order":2,"answer_fr":"Les trucks individuels peuvent servir jusqu'à 300 invités par heure. Pour les grands événements, plusieurs trucks peuvent être déployés simultanément.","answer_it":"I singoli truck possono servire fino a 300 ospiti all'ora. Per eventi più grandi, più truck possono essere utilizzati contemporaneamente.","question_fr":"Combien d'invités sont possibles ?","question_it":"Quanti ospiti sono possibili?"},{"id":"b7c76241-35d3-4692-a886-7ac30f1aeeed","question_de":"Kommt ihr in die ganze Schweiz?","answer_de":"Ja. Unser Heimgebiet ist Zürich, Wetzikon und der Zürcher Oberland, aber wir fahren für Events in die ganze Schweiz – je nach Aufwand mit Anfahrtspauschale.","question_en":"Do you come to all of Switzerland?","answer_en":"Yes. Our home area is Zurich, Wetzikon and the Zurich Oberland, but we travel across Switzerland for events – with a travel surcharge depending on distance.","order":3,"answer_fr":"Oui. Notre zone d'origine est Zurich, Wetzikon et l'Oberland zurichois, mais nous nous déplaçons dans toute la Suisse pour les événements – avec un forfait de déplacement selon la distance.","answer_it":"Sì. La nostra zona di base è Zurigo, Wetzikon e l'Oberland zurighese, ma ci spostiamo in tutta la Svizzera per eventi – con un supplemento di viaggio a seconda della distanza.","question_fr":"Venez-vous dans toute la Suisse ?","question_it":"Venite in tutta la Svizzera?"},{"id":"1951477f-a73a-4158-b956-c4ad95a5e0d2","question_de":"Braucht ihr Strom und Wasser?","answer_de":"Je nach Truck unterschiedlich. Die genauen technischen Anforderungen geben wir euch nach der Anfrage mit den Unterlagen weiter.","question_en":"Do you need power and water?","answer_en":"It varies by truck. We'll provide detailed technical requirements with the documentation after your inquiry.","order":4,"answer_fr":"Cela varie selon le truck. Nous vous communiquerons les exigences techniques détaillées avec la documentation après votre demande.","answer_it":"Varia a seconda del truck. Vi comunicheremo i requisiti tecnici dettagliati con la documentazione dopo la vostra richiesta.","question_fr":"Avez-vous besoin d'électricité et d'eau ?","question_it":"Avete bisogno di corrente e acqua?"},{"id":"b53c9796-e99e-4e4b-9605-819db09261c4","question_de":"Gibt es vegetarische/vegane Optionen?","answer_de":"Ja, bei allen Konzepten sind vegetarische Optionen verfügbar. Vegane Anpassungen sind je nach Konzept möglich – bitte beim Anfragen angeben.","question_en":"Are there vegetarian/vegan options?","answer_en":"Yes, vegetarian options are available with all concepts. Vegan adaptations are possible depending on the concept – please specify when inquiring.","order":5,"answer_fr":"Oui, des options végétariennes sont disponibles pour tous les concepts. Des adaptations véganes sont possibles selon le concept – veuillez le préciser lors de votre demande.","answer_it":"Sì, opzioni vegetariane sono disponibili per tutti i concetti. Adattamenti vegani sono possibili a seconda del concetto – indicatelo nella vostra richiesta.","question_fr":"Y a-t-il des options végétariennes/véganes ?","question_it":"Ci sono opzioni vegetariane/vegane?"},{"id":"56af6108-2b2f-4de1-961a-9a849f828959","question_de":"Was kostet ein Foodtruck-Einsatz?","answer_de":"Der Preis hängt von Gästezahl, Ort, Einsatzdauer und Konzept ab. Wir kalkulieren individuell und senden euch eine transparente Offerte.","question_en":"What does a food truck deployment cost?","answer_en":"The price depends on guest count, location, duration, and concept. We calculate individually and send you a transparent offer.","order":6,"answer_fr":"Le prix dépend du nombre d'invités, du lieu, de la durée et du concept. Nous calculons individuellement et vous envoyons une offre transparente.","answer_it":"Il prezzo dipende dal numero di ospiti, dal luogo, dalla durata e dal concetto. Calcoliamo individualmente e vi inviamo un'offerta trasparente.","question_fr":"Combien coûte un déploiement de food truck ?","question_it":"Quanto costa un impiego di food truck?"},{"id":"677ab205-cf62-46b0-9a81-eba56339a2f5","question_de":"Kann man mehrere Trucks buchen?","answer_de":"Ja, genau das ist unsere Stärke. Ihr könnt mehrere Konzepte kombinieren und so für Abwechslung und kürzere Wartezeiten sorgen.","question_en":"Can I book multiple trucks?","answer_en":"Yes, that's exactly our strength. You can combine multiple concepts to provide variety and shorter wait times.","order":7,"answer_fr":"Oui, c'est exactement notre force. Vous pouvez combiner plusieurs concepts pour offrir de la variété et des temps d'attente plus courts.","answer_it":"Sì, è esattamente il nostro punto di forza. Potete combinare più concetti per offrire varietà e tempi di attesa più brevi.","question_fr":"Peut-on réserver plusieurs trucks ?","question_it":"Si possono prenotare più truck?"},{"id":"51c272b2-31b7-4d67-b81f-ef840fbac6c1","question_de":"Was passiert bei schlechtem Wetter?","answer_de":"Unsere Trucks sind grundsätzlich wetterfest. Bei extremen Bedingungen besprechen wir gemeinsam Alternativen. Details regeln wir im Vertrag.","question_en":"What happens in bad weather?","answer_en":"Our trucks are generally weatherproof. In extreme conditions, we discuss alternatives together. Details are regulated in the contract.","order":8,"answer_fr":"Nos trucks sont généralement résistants aux intempéries. En cas de conditions extrêmes, nous discutons ensemble des alternatives. Les détails sont réglés dans le contrat.","answer_it":"I nostri truck sono generalmente resistenti alle intemperie. In caso di condizioni estreme, discutiamo insieme delle alternative. I dettagli sono regolati nel contratto.","question_fr":"Que se passe-t-il en cas de mauvais temps ?","question_it":"Cosa succede con il brutto tempo?"}]}]]}]
:HL["https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap","style"]
13:Tc01,{"@context":"https://schema.org","@type":"FoodEstablishment","name":"TRUCKSonROAD GmbH","alternateName":"TRUCKSonROAD GmbH - Premium Foodtrucks","description":"Premium Foodtrucks für Festivals, Firmenanlässe und Private Events in der ganzen Schweiz. 6 einzigartige Truck-Konzepte: Burger, Chicken Burger, Bowls, Pocket Bowls, Empanadas und Retro Trailer.","url":"https://trucksonroad.ch","telephone":"+41 79 696 98 99","email":"info@truckonroad.ch","servesCuisine":["Burger","Bowls","Empanadas","Street Food"],"priceRange":"$$","address":{"@type":"PostalAddress","streetAddress":"Bahnhofstrasse 75","addressLocality":"8620 Wetzikon","addressCountry":"CH"},"geo":{"@type":"GeoCoordinates","latitude":47.3769,"longitude":8.5417},"areaServed":{"@type":"Country","name":"Schweiz"},"sameAs":[],"hasMenu":{"@type":"Menu","hasMenuSection":[{"@type":"MenuSection","name":"Burger Truck","description":"Klassische und kreative Burger vom Foodtruck"},{"@type":"MenuSection","name":"Bowl Truck","description":"Frische Bowls mit saisonalen Zutaten"},{"@type":"MenuSection","name":"Empanadas Truck","description":"Handgemachte Empanadas mit verschiedenen Füllungen"}]},"additionalType":"https://schema.org/CateringService","knowsAbout":["Foodtruck Catering","Festival Catering","Firmenanlass Catering","Hochzeit Catering","Event Catering Schweiz"],"makesOffer":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Foodtruck Catering für Festivals","description":"Premium Foodtruck-Catering für Open-Air-Festivals und Grossveranstaltungen in der Schweiz"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Foodtruck für Firmenanlässe","description":"Individuelles Foodtruck-Erlebnis für Firmenevents, Teambuilding und Firmenanlässe"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Foodtruck für Private Events","description":"Exklusives Foodtruck-Catering für Hochzeiten, Geburtstage und private Feiern"}}],"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":4,"bestRating":5,"worstRating":1},"review":[{"@type":"Review","author":{"@type":"Person","name":"Muster AG"},"reviewRating":{"@type":"Rating","ratingValue":5},"reviewBody":"Fantastischer Service! Der Burger Truck war das Highlight unseres Firmenevents.","datePublished":"2025-11-15"},{"@type":"Review","author":{"@type":"Person","name":"Familie Weber"},"reviewRating":{"@type":"Rating","ratingValue":5},"reviewBody":"Unsere Hochzeit wurde durch TruckOnRoad perfekt abgerundet. Die Empanadas waren ein Traum!","datePublished":"2025-09-22"},{"@type":"Review","author":{"@type":"Person","name":"OpenAir Zürich"},"reviewRating":{"@type":"Rating","ratingValue":4},"reviewBody":"Professionell, pünktlich und top Qualität. Die Bowl Trucks kamen super an bei unserem Festival.","datePublished":"2025-08-10"},{"@type":"Review","author":{"@type":"Person","name":"Stefan M."},"reviewRating":{"@type":"Rating","ratingValue":5},"reviewBody":"Absolut top! Die Burger waren fantastisch und der Service war perfekt. Wir buchen euch sicher wieder!","datePublished":"2026-03-15"}]}2:["$","html",null,{"lang":"de","children":[["$","head",null,{"children":[["$","meta",null,{"charSet":"utf-8"}],["$","meta",null,{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","link",null,{"rel":"preconnect","href":"https://fonts.googleapis.com"}],["$","link",null,{"rel":"preconnect","href":"https://fonts.gstatic.com","crossOrigin":""}],["$","link",null,{"href":"https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap","rel":"stylesheet"}],null,[["$","script","layout-jsonld-0",{"id":"layout-jsonld-0","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$13"}}],"$L14","$L15","$L16","$L17"]]}],"$L18"]}]
