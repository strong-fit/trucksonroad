d:[["$","title","0",{"children":"FAQ – Häufige Fragen | TRUCKSonROAD"}],["$","meta","1",{"name":"description","content":"Häufig gestellte Fragen zu TRUCKSonROAD Foodtruck-Catering. Preise, Buchung, Ablauf und mehr."}],["$","meta","2",{"name":"robots","content":"index, follow"}],["$","link","3",{"rel":"canonical","href":"https://trucksonroad.ch/faq"}],["$","meta","4",{"property":"og:title","content":"TRUCKSonROAD – Einzigartige Foodtrucks für Events"}],["$","meta","5",{"property":"og:description","content":"Auffällige Trucks, einzigartiges Essen, professionelle Organisation. Individuelles Angebot in 24h."}],["$","meta","6",{"property":"og:site_name","content":"TRUCKSonROAD"}],["$","meta","7",{"property":"og:type","content":"website"}],["$","meta","8",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","9",{"name":"twitter:title","content":"TRUCKSonROAD – Einzigartige Foodtrucks für Events"}],["$","meta","10",{"name":"twitter:description","content":"Auffällige Trucks, einzigartiges Essen, professionelle Organisation. Individuelles Angebot in 24h."}]]
