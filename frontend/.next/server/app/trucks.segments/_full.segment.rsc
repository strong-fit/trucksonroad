1a:T709,{"@context":"https://schema.org","@type":"ItemList","name":"TRUCKSonROAD Foodtruck-Flotte","url":"https://trucksonroad.ch/trucks","numberOfItems":6,"itemListElement":[{"@type":"ListItem","position":1,"url":"https://trucksonroad.ch/trucks/burger-truck","name":"Burger Truck","description":"Für Events mit 200+ Gästen – schnell, heiss, unvergesslich","image":"https://images.unsplash.com/photo-1565123409695-7b5ef63a2efb?w=1200&q=80"},{"@type":"ListItem","position":2,"url":"https://trucksonroad.ch/trucks/chicken-burger-truck","name":"Chicken Burger Truck","description":"Knusprig & würzig – das Highlight auf jedem Firmenanlass","image":"https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=600&q=80"},{"@type":"ListItem","position":3,"url":"https://trucksonroad.ch/trucks/bowl-truck","name":"Bowl Truck","description":"Frisch & gesund – perfekt für gesundheitsbewusste Events","image":"https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=600&q=80"},{"@type":"ListItem","position":4,"url":"https://trucksonroad.ch/trucks/pocket-bowl-truck","name":"Pocket Bowl Truck","description":"Bis 400 Gäste/h – ideal für Festivals & Grossevents","image":"https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=600&q=80"},{"@type":"ListItem","position":5,"url":"https://trucksonroad.ch/trucks/empanadas-truck","name":"Empanadas Truck","description":"Herzhaft & schnell – perfekt für Streetfood-Märkte & Privatfeiern","image":"https://images.unsplash.com/photo-1551504734-5ee1c4a1479b?w=600&q=80"},{"@type":"ListItem","position":6,"url":"https://trucksonroad.ch/trucks/retro-trailer","name":"Retro Trailer","description":"Vintage Charme – der Hingucker auf jeder Hochzeit & Feier","image":"https://images.unsplash.com/photo-1509315811345-672d83ef2fbc?w=600&q=80"}]}5:["$","$L19",null,{"children":[["$","script",null,{"id":"trucks-list-jsonld","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1a"}}],["$","script",null,{"id":"trucks-breadcrumb-jsonld","type":